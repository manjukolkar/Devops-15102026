<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Super Bikes — Paddock Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" rel="stylesheet">
<style>
:root{
  --asphalt:#d9dcde;
  --paper:#eceeef;
  --tyre:#14181b;
  --kerb:#d1281f;
  --steel:#5b666d;
  --rule:#b6bcc0;
  --font:"Archivo","Helvetica Neue",Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--asphalt);color:var(--tyre);line-height:1.55;font-size:1rem}
a{color:inherit}
:focus-visible{outline:3px solid var(--kerb);outline-offset:3px}

/* Kerb stripe: the one memorable element */
.kerb{height:22px;background:repeating-linear-gradient(90deg,var(--kerb) 0 44px,#fff 44px 88px)}

header.top{display:flex;justify-content:space-between;align-items:center;padding:1rem clamp(1rem,4vw,3rem);background:var(--tyre);color:#fff}
header.top strong{font-stretch:125%;font-weight:800;letter-spacing:.02em}
header.top nav{display:flex;gap:1.5rem;font-size:.95rem}
header.top a{text-decoration:none;color:#d4d8da}
header.top a:hover{color:#fff;text-decoration:underline}

.hero{padding:clamp(2.5rem,8vw,6rem) clamp(1rem,4vw,3rem) 2.5rem;max-width:1200px;margin:0 auto}
.hero h1{font-stretch:125%;font-weight:900;font-size:clamp(3rem,13vw,9.5rem);line-height:.88;letter-spacing:-.02em}
.hero p{max-width:34rem;margin-top:1.5rem;font-size:1.15rem;color:var(--steel)}

main{max-width:1200px;margin:0 auto;padding:0 clamp(1rem,4vw,3rem) 4rem}
.controls{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;align-items:center;padding:1rem 0;border-top:2px solid var(--tyre);border-bottom:1px solid var(--rule);margin-bottom:2rem}
.controls span{font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:.5rem}
.chip,select{font:inherit;font-weight:600;padding:.5rem 1rem;border:2px solid var(--tyre);background:transparent;color:var(--tyre);cursor:pointer;border-radius:0}
.chip[aria-pressed="true"]{background:var(--tyre);color:#fff}
.chip:hover{background:var(--paper)}
.chip[aria-pressed="true"]:hover{background:var(--tyre)}
select{background:var(--paper)}
.count{margin-left:auto;color:var(--steel);font-size:.95rem}

#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr));gap:1.5rem}
.bike{background:var(--paper);padding:1.5rem;border-left:8px solid var(--tyre);display:flex;flex-direction:column;gap:1rem}
.bike.v4{border-left-color:var(--kerb)}
.bike header{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}
.bike h3{font-stretch:112%;font-weight:800;font-size:1.35rem;line-height:1.15}
.make{color:var(--steel);font-size:.9rem}
.year{font-weight:700;color:var(--steel);white-space:nowrap}
.power{display:flex;flex-direction:column;gap:.35rem}
.power b{font-stretch:125%;font-weight:900;font-size:2.4rem;line-height:1}
.power small{font-size:.9rem;color:var(--steel)}
.bar{height:10px;background:var(--rule)}
.bar i{display:block;height:100%;background:var(--tyre);width:0;transition:width .5s ease}
.bike.v4 .bar i{background:var(--kerb)}
dl{display:grid;grid-template-columns:auto 1fr;gap:.35rem 1rem;font-size:.95rem;border-top:1px solid var(--rule);padding-top:1rem}
dt{color:var(--steel)}
dd{font-weight:600;text-align:right}
.note{font-size:.95rem}
.empty{padding:2rem;background:var(--paper)}

.about{margin-top:4rem;display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.about h2{font-stretch:112%;font-weight:800;font-size:1.3rem;margin-bottom:.5rem}
.about p{max-width:36rem}

footer{background:var(--tyre);color:#c4c9cc;padding:2rem clamp(1rem,4vw,3rem);font-size:.9rem}
footer p{max-width:1200px;margin:0 auto}

@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.bar i{transition:none}}
@media (max-width:560px){header.top nav{display:none}.count{margin-left:0;width:100%}}
</style>
</head>
<body>

<div class="kerb" aria-hidden="true"></div>
<header class="top">
  <strong>Paddock Guide</strong>
  <nav aria-label="Main">
    <a href="#bikes">Bikes</a>
    <a href="#about">How to read the numbers</a>
  </nav>
</header>

<section class="hero">
  <h1>Super<br>bikes</h1>
  <p>Six current superbikes compared on power, weight and engine layout. Filter by engine, sort by what matters to you.</p>
</section>

<main id="bikes">
  <div class="controls">
    <span id="filter-label">Engine</span>
    <div class="chips" role="group" aria-labelledby="filter-label" id="chips"></div>
    <label for="sort" class="visually"><span>Sort by</span></label>
    <select id="sort">
      <option value="power">Most power</option>
      <option value="weight">Lightest</option>
      <option value="ratio">Best power-to-weight</option>
      <option value="name">Name A–Z</option>
    </select>
    <span class="count" id="count" aria-live="polite"></span>
  </div>

  <div id="grid"></div>

  <section class="about" id="about">
    <div>
      <h2>Power</h2>
      <p>Figures are manufacturer claims at the crankshaft, in horsepower. They are useful for comparing bikes, but real-world output at the rear wheel is lower.</p>
    </div>
    <div>
      <h2>Weight</h2>
      <p>Wet weight with fuel and fluids, as published for the base model of each bike. Variants with carbon parts or lithium batteries weigh less.</p>
    </div>
    <div>
      <h2>Power-to-weight</h2>
      <p>Horsepower per kilogram. It predicts how a bike accelerates better than power alone, which is why light bikes feel so fast.</p>
    </div>
  </section>
</main>

<footer>
  <p>Specifications are approximate and based on manufacturer claims for recent model years. Check the maker’s website before you buy or compare.</p>
</footer>
<div class="kerb" aria-hidden="true"></div>

<script>
const bikes = [
  { make:"Ducati",   name:"Panigale V4 S",       year:2024, engine:"V4",       cc:1103, hp:215, kg:187, top:"Quickshifter, semi-active suspension, winglets" , note:"Race-derived V4 with the most electronics in this list." },
  { make:"Kawasaki", name:"Ninja H2",            year:2024, engine:"Inline-4", cc:998,  hp:228, kg:238, top:"Supercharged engine", note:"The only supercharged bike here, with the most power and the most weight." },
  { make:"BMW",      name:"S 1000 RR",           year:2024, engine:"Inline-4", cc:999,  hp:206, kg:197, top:"Variable valve timing", note:"Smooth and fast, with a wide range of rider modes." },
  { make:"Aprilia",  name:"RSV4 1100 Factory",   year:2024, engine:"V4",       cc:1099, hp:217, kg:202, top:"Öhlins semi-active suspension", note:"Compact V4 known for sharp handling." },
  { make:"Honda",    name:"CBR1000RR-R SP",      year:2024, engine:"Inline-4", cc:999,  hp:214, kg:201, top:"Brembo Stylema brakes", note:"Built from Honda’s MotoGP experience, with strong top-end power." },
  { make:"Yamaha",   name:"YZF-R1M",             year:2024, engine:"Crossplane", cc:998, hp:197, kg:202, top:"Carbon bodywork, Öhlins electronics", note:"Distinctive crossplane engine with a strong, tractable feel." }
];

const state = { engine:"All", sort:"power" };
const engines = ["All", ...new Set(bikes.map(b => b.engine))];
const maxHp = Math.max(...bikes.map(b => b.hp));
const ratio = b => b.hp / b.kg;

const chips = document.getElementById("chips");
const grid  = document.getElementById("grid");
const count = document.getElementById("count");
const sort  = document.getElementById("sort");

engines.forEach(e => {
  const btn = document.createElement("button");
  btn.className = "chip";
  btn.type = "button";
  btn.textContent = e;
  btn.setAttribute("aria-pressed", e === state.engine);
  btn.addEventListener("click", () => {
    state.engine = e;
    chips.querySelectorAll(".chip").forEach(c => c.setAttribute("aria-pressed", c.textContent === e));
    render();
  });
  chips.appendChild(btn);
});

sort.addEventListener("change", () => { state.sort = sort.value; render(); });

function esc(s){ return String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }

function render(){
  let list = bikes.filter(b => state.engine === "All" || b.engine === state.engine);
  const sorters = {
    power:  (a,b) => b.hp - a.hp,
    weight: (a,b) => a.kg - b.kg,
    ratio:  (a,b) => ratio(b) - ratio(a),
    name:   (a,b) => (a.make + a.name).localeCompare(b.make + b.name)
  };
  list.sort(sorters[state.sort]);

  count.textContent = list.length + (list.length === 1 ? " bike" : " bikes");

  if (!list.length){
    grid.innerHTML = '<p class="empty">No bikes match this filter. Choose another engine type.</p>';
    return;
  }

  grid.innerHTML = list.map(b => `
    <article class="bike ${b.engine === "V4" ? "v4" : ""}">
      <header>
        <div>
          <div class="make">${esc(b.make)}</div>
          <h3>${esc(b.name)}</h3>
        </div>
        <span class="year">${b.year}</span>
      </header>
      <div class="power">
        <b>${b.hp}<small> hp</small></b>
        <div class="bar" role="img" aria-label="${b.hp} of ${maxHp} horsepower, relative to the most powerful bike"><i data-w="${(b.hp / maxHp * 100).toFixed(1)}"></i></div>
      </div>
      <dl>
        <dt>Engine</dt><dd>${b.cc} cc ${esc(b.engine)}</dd>
        <dt>Weight</dt><dd>${b.kg} kg</dd>
        <dt>Power-to-weight</dt><dd>${ratio(b).toFixed(2)} hp/kg</dd>
        <dt>Key feature</dt><dd>${esc(b.top)}</dd>
      </dl>
      <p class="note">${esc(b.note)}</p>
    </article>`).join("");

  requestAnimationFrame(() => {
    grid.querySelectorAll(".bar i").forEach(i => { i.style.width = i.dataset.w + "%"; });
  });
}

render();
</script>
</body>
</html>

pipeline{
    agent any

    stages{
        stage("hostname"){
            steps{
                sh "hostname"
            }
        }
        stage("Ip address"){
            steps{
                sh "hostname -I"
            }
        }
        stage("Cpu Details"){
            steps{
                sh "lscpu"
            }
        }
        stage("Memory usage"){
            steps{
                sh "free -h"
            }
        }
        stage("Disk Utilization"){
            steps{
                sh "df -h"
            }
        }
    }
}
